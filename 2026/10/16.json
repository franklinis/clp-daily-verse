    "ta": {
      "lang": "ta",
      "reference": "கலாத்தியர் 6:9",
      "text": "நன்மைசெய்கிறதில் சோர்ந்துபோகாமல் இருப்போமாக; நாம் தளர்ந்துபோகாதிருந்தால் ஏற்றகாலத்தில் அறுப்போம்."
    },
    "en": {
      "lang": "en",
      "reference": "Galatians 6:9",
      "text": "And let us not be weary in well doing: for in due season we shall reap, if we faint not."
    },
    "de": {
      "lang": "de",
      "reference": "Galater 6,9",
      "text": "Lasset uns aber Gutes tun und nicht müde werden; denn zu seiner Zeit werden wir auch ernten ohne Aufhören."
    }
  },
