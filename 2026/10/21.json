    "ta": {
      "lang": "ta",
      "reference": "சங்கீதம் 40:8",
      "text": "என் தேவனே, உமக்குப் பிரியமானதைச் செய்ய விரும்புகிறேன்; உமது நியாயப்பிரமாணம் என் உள்ளத்திற்குள் இருக்கிறது என்று சொன்னேன்."
    },
    "en": {
      "lang": "en",
      "reference": "Psalm 40:8",
      "text": "I delight to do thy will, O my God: yea, thy law is within my heart."
    },
    "de": {
      "lang": "de",
      "reference": "Psalm 40,8",
      "text": "Deinen Willen, mein Gott, tue ich gern, und dein Gesetz habe ich in meinem Herzen."
    }
  },
