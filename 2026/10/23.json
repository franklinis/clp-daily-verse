  "verses": {
    "ta": {
      "lang": "ta",
      "reference": "அப்போஸ்தலர் 17:28",
      "text": "ஏனெனில் அவருக்குள் நாம் பிழைக்கிறோம், அசைகிறோம், இருக்கிறோம்; அப்படியே உங்கள் புலவர்களிலும் சிலர்: நாம் அவருடைய சந்ததியார் என்று சொல்லியிருக்கிறார்கள்."
    },
    "en": {
      "lang": "en",
      "reference": "Acts 17:28",
      "text": "For in him we live, and move, and have our being; as certain also of your own poets have said, For we are also his offspring."
    },
    "de": {
      "lang": "de",
      "reference": "Apostelgeschichte 17,28",
      "text": "Denn in ihm leben, weben und sind wir; wie auch etliche Poeten bei euch gesagt haben: \"Wir sind seines Geschlechts.\""
    }
  },
