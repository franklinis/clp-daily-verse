  "verses": {
    "ta": {
      "lang": "ta",
      "reference": "1 கொரிந்தியர் 8:6",
      "text": "பிதாவாகிய ஒரே தேவன் நமக்குண்டு, அவராலே சகலமும் உண்டாயிருக்கிறது; அவருக்கென்று நாமும் உண்டாயிருக்கிறோம். இயேசுகிறிஸ்து என்னும் ஒரே கர்த்தரும் நமக்குண்டு; அவர்மூலமாய்ச் சகலமும் உண்டாயிருக்கிறது, அவர் மூலமாய் நாமும் உண்டாயிருக்கிறோம்."
    },
    "en": {
      "lang": "en",
      "reference": "1 Corinthians 8:6",
      "text": "But to us there is but one God, the Father, of whom are all things, and we in him; and one Lord Jesus Christ, by whom are all things, and we by him."
    },
    "de": {
      "lang": "de",
      "reference": "1. Korinther 8,6",
      "text": "So haben wir doch nur einen Gott, den Vater, von welchem alle Dinge sind und wir zu ihm; und einen HERRN, Jesus Christus, durch welchen alle Dinge sind und wir durch ihn."
    }
