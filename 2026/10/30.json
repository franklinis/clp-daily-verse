  "verses": {
    "ta": {
      "lang": "ta",
      "reference": "நீதிமொழிகள் 3:5-6",
      "text": "உன் சுயபுத்தியின்மேல் சாயாமல், உன் முழு இருதயத்தோடும் கர்த்தரில் நம்பிக்கையாயிருந்து, உன் வழிகளிலெல்லாம் அவரை நினைத்துக்கொள்; அப்பொழுது அவர் உன் பாதைகளைச் செவ்வைப்படுத்துவார்."
    },
    "en": {
      "lang": "en",
      "reference": "Proverbs 3:5-6",
      "text": "Trust in the LORD with all thine heart; and lean not unto thine own understanding. In all thy ways acknowledge him, and he shall direct thy paths."
    },
    "de": {
      "lang": "de",
      "reference": "Sprüche 3,5-6",
      "text": "Verlaß dich auf den HERRN von ganzem Herzen und verlaß dich nicht auf deinen Verstand; sondern gedenke an ihn in allen deinen Wegen, so wird er dich recht führen."
    }
  },
